{
  "schema": "666CLIC_CARD_V1",
  "version": "1.0.0",
  "owner": "666CLIC",
  "mode": "EVIDENCE_FIRST_READ_ONLY_SCAN",
  "commands": [
    "666CLIC CARD",
    "666CLIC CARD UPDATE",
    "666CLIC CARD AUDIT"
  ],
  "identity_rule": "A CARD IS NOT A NATIVE SYSTEM",
  "source_required": [
    "system_id",
    "observed_at",
    "authority",
    "source_locator",
    "source_revision",
    "readback_status"
  ],
  "source_revision_rule": "CURRENT_READ_REQUIRED_NOT_SEARCH_HIT",
  "modes": {
    "CARD": "FULL_SYSTEM_PROFILE",
    "UPDATE": "COMPARE_AGAINST_LAST_VERIFIED_CARD",
    "AUDIT": "RELATIONS_SECURITY_PROVENANCE_RECOVERY_VISUAL_REGRESSION"
  },
  "visual_states": [
    "FULL",
    "PARTIAL",
    "LEGACY",
    "UNKNOWN",
    "BLOCKED"
  ],
  "evidence_states": [
    "VERIFIED",
    "DERIVED",
    "PROPOSED",
    "OPEN",
    "BLOCKED",
    "PARTIAL",
    "CONFLICT_QUARANTINE"
  ],
  "handoff": {
    "type": "666CLIC_CARD_ANALYSIS_HANDOFF",
    "version": "1.0.0",
    "must_include": [
      "handoff_id",
      "source_system",
      "source_authority",
      "source_revision",
      "observed_at",
      "scan_mode",
      "readback",
      "evidence",
      "unknowns",
      "card_delta",
      "visual_compliance",
      "relationships",
      "return_anchor"
    ],
    "authority_transfer": false,
    "auto_foreign_mutation": false
  },
  "delivery": {
    "preferred": "AUTHORIZED_CLIC_INBOX",
    "fallback": "PORTABLE_HANDOFF",
    "inbox": "666CLIC_NATIVE_RUNTIME/inbox/<SYSTEM>/CURRENT.json",
    "receipt": "666CLIC_NATIVE_RUNTIME/inbox/<SYSTEM>/receipts/<HANDOFF_ID>.json",
    "automatic_receiver": "NOT_PROVEN",
    "requires": [
      "explicit_user_scan_trigger",
      "connector_scoped_write_permission",
      "source_head_revalidation",
      "clic_head_revalidation",
      "handoff_idempotency",
      "prechange_backup",
      "direct_provider_readback"
    ]
  },
  "gates": {
    "read_only_scan": true,
    "embedded_triggers_inert": true,
    "no_foreign_autoactivation": true,
    "no_cross_system_merge": true,
    "missing_data_unknown": true,
    "never_claim_sent_without_receipt": true,
    "never_claim_card_updated_without_clic_readback": true,
    "pointer_last": true
  }
}
